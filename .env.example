# ─────────────────────────────────────────────────────────────────────────────
# AcademyGlider — variables de entorno
# Copia este archivo como `.env` y completa los valores. NUNCA subas `.env` al repo.
# En producción, define estas mismas variables en Vercel (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio (usada para metadatos y enlaces absolutos)
PUBLIC_SITE_URL="https://academyglider.vercel.app"

# ── Sanity (CMS) ────────────────────────────────────────────────────────────
# Se obtienen en https://www.sanity.io/manage tras crear el proyecto.
# Si NO defines PUBLIC_SANITY_PROJECT_ID, el sitio usa el contenido DEMO local
# incluido en src/data/demoContent.ts (útil para desarrollo sin CMS).
PUBLIC_SANITY_PROJECT_ID=""
PUBLIC_SANITY_DATASET="production"
PUBLIC_SANITY_API_VERSION="2024-10-01"
# Token de sólo lectura (Project → API → Tokens). Sólo necesario si el dataset es privado.
SANITY_API_READ_TOKEN=""
# Secreto compartido para validar el webhook de revalidación (lo inventas tú).
SANITY_REVALIDATE_SECRET=""

# ── Instagram (galería) ─────────────────────────────────────────────────────
# Requiere cuenta Business/Creator + app en https://developers.facebook.com
# Producto: "Instagram" · Permiso: instagram_business_basic
META_APP_ID=""
META_APP_SECRET=""
# ID numérico del usuario de Instagram (lo entrega el flujo de login de la Graph API).
INSTAGRAM_USER_ID=""
# Token de larga duración (60 días). El cron /api/cron/refresh-instagram-token lo rota.
INSTAGRAM_LONG_LIVED_TOKEN=""
# Secreto que exige Vercel Cron para invocar la función protegida (lo inventas tú).
CRON_SECRET=""

# ── Mercado Pago (RESERVADO — no implementado todavía) ──────────────────────
# Dejar vacío. Documentado en README §"Futura integración con Mercado Pago".
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
