---
import "@/styles/global.css";
import type { Locale } from "@/types";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  alternateHref: string;
}

const {
  locale,
  title,
  description,
  ogImage = "/logo-academyglider.jpg",
  alternateHref,
} = Astro.props;
const site = Astro.site ?? new URL("https://academyglider.vercel.app");
const canonical = new URL(Astro.url.pathname, site).toString();
const other: Locale = locale === "es" ? "en" : "es";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(alternateHref, site).toString()} />
    <link rel="alternate" hreflang={locale} href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, site).toString()} />
    <meta property="og:locale" content={locale === "es" ? "es_CL" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-academyglider.jpg" />
    <meta name="theme-color" content="#e15554" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2"
      >{locale === "es" ? "Saltar al contenido" : "Skip to content"}</a
    >
    <slot />

    <script>
      // Reveal-on-scroll global (respeta prefers-reduced-motion vía CSS).
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .focus\:not-sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
</style>
