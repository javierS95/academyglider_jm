---
/**
 * Imagen de fondo a pantalla completa (object-cover) con recorte distinto para
 * móvil y escritorio.
 *
 * - Foto de Sanity CON punto focal (hotspot): Sanity recorta cada versión
 *   centrada en ese punto, respetando también el recorte marcado en el Studio.
 * - Foto de Sanity SIN punto focal: Sanity elige solo la zona con más detalle
 *   (crop=entropy), para que no se corte la vela o el piloto por estar al centro.
 * - Foto local (modo DEMO): se usa tal cual, como antes.
 */
import type { ImageAsset } from "@/types";
import { urlForImage } from "@/lib/sanity";

interface Props {
  image: ImageAsset;
  alt: string;
  /** Proporción ancho/alto del recorte para móvil (< 768px). */
  mobileRatio: number;
  /** Proporción ancho/alto del recorte para escritorio (≥ 768px). */
  desktopRatio: number;
  /** true = imagen principal (LCP): carga prioritaria, sin lazy. */
  priority?: boolean;
  class?: string;
}

const { image, alt, mobileRatio, desktopRatio, priority = false, class: className } = Astro.props;

const MOBILE_WIDTHS = [480, 800, 1080];
const DESKTOP_WIDTHS = [1280, 1920, 2560];

const sanityImage = image.asset?._ref ? urlForImage(image) : null;
const fromSanity = sanityImage !== null;
// Sanity guarda un hotspot "por defecto" (centro, tamaño completo) apenas alguien
// abre el editor de la imagen; ese caso cuenta como "sin marcar".
const h = image.hotspot;
const hasHotspot = Boolean(
  h && !(h.x === 0.5 && h.y === 0.5 && (h.width ?? 1) >= 1 && (h.height ?? 1) >= 1),
);

const build = (width: number, ratio: number) => {
  let b = sanityImage!
    .width(width)
    .height(Math.round(width / ratio))
    .fit("crop")
    .auto("format")
    .quality(80);
  if (!hasHotspot) b = b.crop("entropy");
  return b.url();
};

const srcset = (widths: number[], ratio: number) =>
  widths.map((w) => `${build(w, ratio)} ${w}w`).join(", ");

const loadAttrs = priority
  ? { fetchpriority: "high" as const, loading: "eager" as const }
  : { loading: "lazy" as const };
---

{
  fromSanity ? (
    <picture>
      <source
        media="(min-width: 768px)"
        srcset={srcset(DESKTOP_WIDTHS, desktopRatio)}
        sizes="100vw"
      />
      <img
        src={build(MOBILE_WIDTHS[1], mobileRatio)}
        srcset={srcset(MOBILE_WIDTHS, mobileRatio)}
        sizes="100vw"
        alt={alt}
        decoding="async"
        class:list={["object-cover", className]}
        {...loadAttrs}
      />
    </picture>
  ) : (
    <img
      src={image.url}
      alt={alt}
      decoding="async"
      class:list={["object-cover", className]}
      {...loadAttrs}
    />
  )
}
