---
import type { Locale, SiteContent } from "@/types";
import { useTranslations } from "@/i18n/ui";
import { whatsappLink } from "@/lib/whatsapp";

interface Props {
  locale: Locale;
  content: SiteContent;
}
const { locale, content } = Astro.props;
const t = useTranslations(locale);
const wa = whatsappLink(
  content.settings.whatsappNumber,
  content.settings.whatsappDefaultMessage,
  locale,
);
---

<a
  id="wa-float"
  href={wa}
  target="_blank"
  rel="noopener"
  aria-label={t("wa.aria")}
  class="fixed right-4 bottom-4 z-30 flex translate-y-24 items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 text-sm font-semibold text-white opacity-0 shadow-xl transition-all duration-300"
>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M.06 24l1.68-6.14a11.87 11.87 0 01-1.6-5.95C.14 5.34 5.5 0 12.08 0a11.82 11.82 0 018.42 3.5 11.75 11.75 0 013.5 8.4c0 6.57-5.37 11.9-11.95 11.9a12 12 0 01-5.72-1.46L.06 24zM6.6 20.13l.36.22a9.9 9.9 0 005.06 1.38c5.45 0 9.9-4.42 9.9-9.86a9.78 9.78 0 00-2.9-6.99 9.83 9.83 0 00-7-2.9c-5.46 0-9.9 4.43-9.9 9.87a9.8 9.8 0 001.52 5.26l.24.38-1 3.63 3.72-.98zM17.4 14.6c-.07-.12-.27-.2-.56-.34-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.29-.76.95-.93 1.15-.17.2-.34.22-.63.07a8.1 8.1 0 01-2.38-1.47 8.94 8.94 0 01-1.65-2.05c-.17-.3-.02-.46.13-.6.13-.14.3-.34.44-.51.15-.17.2-.3.3-.5.1-.19.05-.36-.02-.5-.08-.15-.66-1.6-.9-2.19-.24-.57-.48-.5-.66-.5l-.56-.02c-.2 0-.5.07-.77.36-.27.29-1.02 1-1.02 2.42 0 1.43 1.04 2.8 1.19 3 .15.19 2.05 3.12 4.96 4.38.7.3 1.24.48 1.66.62.7.22 1.33.19 1.83.11.56-.08 1.75-.71 2-1.4.24-.7.24-1.28.17-1.4z"
    ></path>
  </svg>
  <span class="hidden sm:inline">{t("wa.float")}</span>
</a>

<script>
  const el = document.getElementById("wa-float");
  if (el) {
    const update = () => {
      const past = window.scrollY > window.innerHeight * 0.8;
      const menuOpen = document.body.classList.contains("menu-open");
      const show = past && !menuOpen;
      el.classList.toggle("translate-y-24", !show);
      el.classList.toggle("opacity-0", !show);
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
    const mo = new MutationObserver(update);
    mo.observe(document.body, { attributes: true, attributeFilter: ["class"] });
  }
</script>
