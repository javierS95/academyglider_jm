---
import type { Locale, SiteContent } from "@/types";
import { pick } from "@/i18n/utils";
import { useTranslations } from "@/i18n/ui";
import { whatsappLink } from "@/lib/whatsapp";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
  locale: Locale;
  content: SiteContent;
}
const { locale, content } = Astro.props;
const t = useTranslations(locale);
const { headers, settings } = content;

const categories = content.faqCategories
  .filter((c) => c.active)
  .sort((a, b) => a.order - b.order)
  .map((c) => ({
    id: c._id,
    name: pick(c.name, locale),
    items: content.faqItems
      .filter((i) => i.active && i.categoryId === c._id)
      .sort((a, b) => a.order - b.order)
      .map((i) => ({ q: pick(i.question, locale), a: pick(i.answer, locale) })),
  }))
  .filter((c) => c.items.length > 0);

const wa = whatsappLink(settings.whatsappNumber, settings.whatsappDefaultMessage, locale);

const strings = {
  welcome: pick(headers.faq.welcome, locale),
  pickCategory: t("faq.pickCategory"),
  pickQuestion: t("faq.pickQuestion"),
  backToCategories: t("faq.backToCategories"),
  questionOne: t("faq.questionOne"),
  questionMany: t("faq.questionMany"),
  typing: t("faq.typing"),
  another: t("faq.another"),
  you: t("faq.you"),
  bot: t("faq.bot"),
};
---

<section id="faq" class="section bg-sky-900 text-white">
  <div class="container-page">
    <SectionHeading
      locale={locale}
      eyebrow="FAQ"
      title={pick(headers.faq.title, locale)}
      intro={pick(headers.faq.intro, locale)}
      isDemo={headers.faq.isDemo}
      demoMode={settings.demoMode}
      onDark
    />

    <div
      id="faq-bot"
      class="reveal mx-auto mt-10 max-w-2xl overflow-hidden rounded-[var(--radius-xl)] bg-white text-ink-900 shadow-2xl"
      data-faq={JSON.stringify(categories)}
      data-strings={JSON.stringify(strings)}
    >
      <div class="flex items-center gap-2 border-b border-ink-900/10 bg-sand-50 px-5 py-3">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-forest-400"></span>
        <span class="text-sm font-semibold">{strings.bot}</span>
      </div>
      <div
        id="faq-log"
        class="flex max-h-[26rem] min-h-[18rem] flex-col gap-3 overflow-y-auto px-5 py-5"
        aria-live="polite"
      >
      </div>
      <div
        id="faq-choices"
        class="flex flex-col items-start gap-3 border-t border-ink-900/10 bg-sand-50/60 px-5 py-4"
      >
      </div>
      <div class="border-t border-ink-900/10 px-5 py-3 text-center">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="text-sm font-semibold text-sunset-600 underline"
        >
          {t("faq.toWhatsapp")}
        </a>
      </div>
    </div>

    <noscript>
      <div class="mx-auto mt-6 max-w-2xl space-y-4 rounded-xl bg-white p-6 text-ink-900">
        {
          categories.map((c) => (
            <div>
              <h3 class="font-display text-lg">{c.name}</h3>
              <dl class="mt-2 space-y-2">
                {c.items.map((it) => (
                  <div>
                    <dt class="font-semibold">{it.q}</dt>
                    <dd class="text-ink-700">{it.a}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </noscript>
  </div>
</section>

<style is:global>
  .faq-typing span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: var(--color-ink-700);
    opacity: 0.35;
    animation: faq-dot 1s infinite ease-in-out;
  }
  .faq-typing span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .faq-typing span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes faq-dot {
    0%,
    80%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    40% {
      opacity: 0.9;
      transform: translateY(-3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-typing span {
      animation: none;
    }
  }
</style>

<script>
  type Cat = { id: string; name: string; items: { q: string; a: string }[] };
  const root = document.getElementById("faq-bot");
  if (root) {
    const cats: Cat[] = JSON.parse(root.dataset.faq || "[]");
    const s = JSON.parse(root.dataset.strings || "{}");
    const log = root.querySelector("#faq-log") as HTMLElement;
    const choices = root.querySelector("#faq-choices") as HTMLElement;

    const bubble = (who: "bot" | "you", text: string) => {
      const wrap = document.createElement("div");
      wrap.className = who === "bot" ? "self-start max-w-[85%]" : "self-end max-w-[85%]";
      const b = document.createElement("div");
      b.className =
        who === "bot"
          ? "rounded-2xl rounded-tl-sm bg-sand-100 px-4 py-2.5 text-sm"
          : "rounded-2xl rounded-tr-sm bg-sky-700 px-4 py-2.5 text-sm text-white";
      b.textContent = text;
      wrap.appendChild(b);
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
    };

    const button = (className: string, onClick: () => void) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = className;
      btn.addEventListener("click", onClick);
      return btn;
    };

    const hint = (text: string) => {
      const el = document.createElement("p");
      el.className = "w-full text-xs font-semibold uppercase tracking-wide text-ink-700/70";
      el.textContent = text;
      return el;
    };

    // Categoría: tarjeta sólida, grande, con flecha → "entrar a un tema".
    const categoryCard = (cat: Cat) => {
      const btn = button(
        "group flex items-center justify-between gap-3 rounded-xl bg-sky-700 px-4 py-3 text-left text-white shadow-sm transition hover:bg-sky-900 hover:shadow-md",
        () => showQuestions(cat),
      );
      const text = document.createElement("span");
      text.className = "flex flex-col";
      const name = document.createElement("span");
      name.className = "font-display text-base font-semibold";
      name.textContent = cat.name;
      const count = document.createElement("span");
      count.className = "text-xs text-white/70";
      count.textContent = `${cat.items.length} ${cat.items.length === 1 ? s.questionOne : s.questionMany}`;
      text.append(name, count);
      const arrow = document.createElement("span");
      arrow.setAttribute("aria-hidden", "true");
      arrow.className = "text-xl transition-transform group-hover:translate-x-1";
      arrow.textContent = "→";
      btn.append(text, arrow);
      return btn;
    };

    // Pregunta: fila liviana con borde y "?" → "esto se envía como mensaje".
    const questionRow = (it: { q: string; a: string }) => {
      const btn = button(
        "flex w-full items-start gap-3 rounded-lg border border-ink-900/10 bg-white px-3.5 py-2.5 text-left text-sm transition-colors hover:border-sunset-400 hover:bg-sunset-50",
        () => showAnswer(it),
      );
      const mark = document.createElement("span");
      mark.setAttribute("aria-hidden", "true");
      mark.className =
        "mt-px flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-sunset-100 text-xs font-bold text-sunset-600";
      mark.textContent = "?";
      const q = document.createElement("span");
      q.textContent = it.q;
      btn.append(mark, q);
      return btn;
    };

    const linkButton = (label: string, onClick: () => void) => {
      const btn = button(
        "text-sm font-semibold text-sky-700 underline-offset-2 hover:underline",
        onClick,
      );
      btn.textContent = label;
      return btn;
    };

    const clearChoices = () => (choices.innerHTML = "");

    const showCategories = () => {
      clearChoices();
      choices.appendChild(hint(s.pickCategory));
      const grid = document.createElement("div");
      grid.className = "grid w-full gap-2 sm:grid-cols-2";
      cats.forEach((c) => grid.appendChild(categoryCard(c)));
      choices.appendChild(grid);
    };

    const showQuestions = (cat: Cat) => {
      // Elegir categoría sólo filtra las preguntas: no se envía como mensaje.
      clearChoices();
      choices.appendChild(hint(cat.name));
      const list = document.createElement("div");
      list.className = "flex w-full flex-col gap-2";
      cat.items.forEach((it) => list.appendChild(questionRow(it)));
      choices.appendChild(list);
      choices.appendChild(linkButton("← " + s.backToCategories, showCategories));
    };

    // Indicador "escribiendo…" para que la respuesta no aparezca de golpe.
    const typing = () => {
      const wrap = document.createElement("div");
      wrap.className = "self-start";
      wrap.setAttribute("aria-label", s.typing);
      wrap.innerHTML =
        '<div class="faq-typing flex gap-1 rounded-2xl rounded-tl-sm bg-sand-100 px-4 py-3.5"><span></span><span></span><span></span></div>';
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
      return wrap;
    };

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // ~0,7 s base + un poco según el largo de la respuesta (tope 1,6 s).
    const thinkTime = (answer: string) =>
      reduceMotion ? 300 : Math.min(700 + answer.length * 8, 1600);

    const showAnswer = (it: { q: string; a: string }) => {
      bubble("you", it.q);
      clearChoices(); // sin opciones mientras "piensa": evita clics dobles
      const dots = typing();
      setTimeout(() => {
        dots.remove();
        bubble("bot", it.a);
        choices.appendChild(linkButton(s.another, showCategories));
      }, thinkTime(it.a));
    };

    bubble("bot", s.welcome);
    showCategories();
  }
</script>
