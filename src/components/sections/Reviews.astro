---
import type { Locale, SiteContent } from "@/types";
import { pick } from "@/i18n/utils";
import { useTranslations } from "@/i18n/ui";
import SectionHeading from "@/components/SectionHeading.astro";
import DemoBadge from "@/components/DemoBadge.astro";

interface Props {
  locale: Locale;
  content: SiteContent;
}
const { locale, content } = Astro.props;
const t = useTranslations(locale);
const { headers, settings } = content;
const reviews = content.reviews.filter((r) => r.active).sort((a, b) => a.order - b.order);
---

<section id="resenas" class="section bg-sand-50">
  <div class="container-page">
    <SectionHeading
      locale={locale}
      eyebrow={t("nav.reviews")}
      title={pick(headers.reviews.title, locale)}
      intro={pick(headers.reviews.intro, locale)}
      isDemo={headers.reviews.isDemo}
      demoMode={settings.demoMode}
    />

    <div
      id="reviews-track"
      class="reveal mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 md:grid md:grid-cols-3 md:overflow-visible"
    >
      {
        reviews.map((r) => (
          <figure class="flex min-w-[85%] snap-center flex-col rounded-[var(--radius-xl)] bg-white p-6 shadow-[0_20px_50px_-30px_rgba(33,29,26,0.4)] ring-1 ring-ink-900/5 sm:min-w-[60%] md:min-w-0">
            {typeof r.rating === "number" && (
              <div class="text-sunset-400" aria-label={`${r.rating}/5`}>
                {"★".repeat(r.rating)}
                <span class="text-ink-900/15">{"★".repeat(5 - r.rating)}</span>
              </div>
            )}
            <blockquote class="mt-3 flex-1 text-ink-700">{pick(r.text, locale)}</blockquote>
            <figcaption class="mt-5 flex items-center gap-3">
              {r.photo && (
                <img
                  src={r.photo.url}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  class="h-10 w-10 rounded-full object-cover"
                />
              )}
              <div>
                <p class="text-sm font-semibold text-ink-900">{r.authorName}</p>
                {r.courseName && <p class="text-xs text-ink-700">{pick(r.courseName, locale)}</p>}
              </div>
              <DemoBadge locale={locale} when={settings.demoMode && r.isDemo} class="ml-auto" />
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-2 flex gap-2 md:hidden">
      <button
        type="button"
        data-rev="-1"
        class="btn btn-outline !px-3 !py-2 text-sm"
        aria-label={t("reviews.prev")}>←</button
      >
      <button
        type="button"
        data-rev="1"
        class="btn btn-outline !px-3 !py-2 text-sm"
        aria-label={t("reviews.next")}>→</button
      >
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("reviews-track");
  document.querySelectorAll<HTMLButtonElement>("[data-rev]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!track) return;
      const dir = Number(btn.dataset.rev);
      track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: "smooth" });
    });
  });
</script>
